# ─── Notion ───────────────────────────────────────────────────────────────────
# Integration token: https://www.notion.so/my-integrations
NOTION_API_TOKEN=secret_PLACEHOLDER_NOTION_INTEGRATION_TOKEN

# Leads database ID (from database URL — 32-char hex, no dashes)
NOTION_LEADS_DATABASE_ID=682f574e415b45f2855a2fd925326b99

# Optional: clinic settings page ID (Google Place ID, notification email, toggles)
NOTION_SETTINGS_PAGE_ID=PLACEHOLDER_SETTINGS_PAGE_ID

# ─── Manychat ─────────────────────────────────────────────────────────────────
# API token: Manychat → Settings → API
MANYCHAT_API_TOKEN=PLACEHOLDER_MANYCHAT_API_TOKEN

# Page ID for the clinic's Manychat account
MANYCHAT_PAGE_ID=PLACEHOLDER_MANYCHAT_PAGE_ID

# ─── Lead capture alerts ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=PLACEHOLDER_TELEGRAM_CHAT_ID

# ─── Email (instant form confirmation via nodemailer) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=PLACEHOLDER_SMTP_USER@gmail.com
SMTP_PASS=PLACEHOLDER_SMTP_APP_PASSWORD
SMTP_FROM=Clínica <noreply@PLACEHOLDER_CLINIC_DOMAIN.pt>

# ─── Clinic defaults (used in message templates) ──────────────────────────────
CLINIC_NAME=PLACEHOLDER_Clinic_Name
CLINIC_PHONE=+351PLACEHOLDER
GOOGLE_PLACE_ID=PLACEHOLDER_GOOGLE_PLACE_ID
